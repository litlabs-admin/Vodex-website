# Initiate Call (landing page Section 5)
# reCAPTCHA v2 "I'm not a robot" checkbox keys - https://www.google.com/recaptcha/admin
# Add every deployed domain (and localhost for dev) to the key's domain list.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional: comma-separated hostnames a solved token must come from (e.g. vodex.ai,www.vodex.ai)
RECAPTCHA_ALLOWED_HOSTNAMES=
# Optional: extra browser origins allowed to POST /api/initiate-call (same-origin is always allowed)
ALLOWED_ORIGINS=
# Defaults to https://prod.api.vodex.ai/api/v1/trigger-demo-call
VODEX_DEMO_CALL_URL=
